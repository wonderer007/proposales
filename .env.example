# Neon Postgres connection string
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# Proposales API (server-side only — never exposed to the browser)
PROPOSALES_API_KEY="your-proposales-api-key"
# Optional. Companies are read from the API and switched in the app; this only
# picks which one is selected before a choice is made, and which one the seed
# scripts use by default. Run scripts/whoami.ts to see the ids.
PROPOSALES_COMPANY_ID=""
PROPOSALES_API_BASE_URL="https://api.proposales.com"

# Vercel AI Gateway
AI_GATEWAY_API_KEY="your-ai-gateway-api-key"
AI_MODEL="anthropic/claude-sonnet-5"
